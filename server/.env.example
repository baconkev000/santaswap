# Render Postgres connection string.
# Format: postgresql://USERNAME:PASSWORD@HOST/DATABASE
DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR_DB_HOST/santaswap

# Used to sign login tokens. Generate a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: hashing salt for join-flow phone rate limits.
PARTICIPANT_LOOKUP_SECRET=replace-with-another-long-random-secret

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

PORT=3001
