# Frontend talks to the SantaSwap API (local or Render web service).
# In local dev, leave empty so Vite proxies /api to localhost:3001.
# In production (Netlify/Vercel build env), set to your Render API origin:
# VITE_API_URL=https://santaswap-1rde.onrender.com
VITE_API_URL=

# Never put DATABASE_URL, JWT_SECRET, or other server secrets here —
# anything prefixed with VITE_ is bundled into the public website.
