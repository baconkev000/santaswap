# Same Supabase project as the SantaSwap mobile app (publishable values only).
# Project URL only — do NOT include /rest/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never put Twilio credentials or the Supabase service-role key here:
# everything prefixed with VITE_ is bundled into the public website.
